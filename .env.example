# OpenAI key for the /api/chat portfolio assistant (server-only, never exposed to the browser).
OPEN_AI_API_KEY=

# Optional — overrides the default model without a code change.
OPENAI_MODEL=gpt-5.6-terra

# Public URL of the deployed site — needed so SvelteKit's CSRF check accepts
# POSTs to /api/chat behind Railway's proxy. Not needed for local dev.
ORIGIN=
